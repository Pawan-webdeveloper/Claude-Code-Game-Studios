    "@gltf-transform/functions": "^4.1.1",
    "@types/three": "^0.170.0",
    "draco3dgltf": "^1.5.7",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
