{
  "name": "trainers-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Trainer's Atlas — Pawan's Pokémon-world portfolio game (Three.js)",
  "scripts": {
    "predev": "node tools/copy-draco.mjs",
    "dev": "vite",
    "prebuild": "node tools/copy-draco.mjs",
